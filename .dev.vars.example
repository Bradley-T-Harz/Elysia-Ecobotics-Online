# Copy to .dev.vars only for local Pages Functions testing. Never commit the copy.
# This disabled development value is not the production release baseline.
SANDBOX_ENABLED="false"
SANDBOX_DEPLOYMENT_ENV="development"
SANDBOX_PUBLIC_ORIGIN="http://localhost:8787"
SANDBOX_SERVICE_URL="https://sandbox.example.invalid"
SANDBOX_SERVICE_TOKEN="replace-directly-in-local-file"
SANDBOX_DB_FINALIZER_TOKEN="replace-directly-in-local-file"
CLOUDFLARE_ACCESS_CLIENT_ID="replace-directly-in-local-file"
CLOUDFLARE_ACCESS_CLIENT_SECRET="replace-directly-in-local-file"
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="replace-with-publishable-key"

# This file belongs only to the Pages/sandbox process. Never add Stripe,
# webhook, payout, banking, or Supabase service-role secrets. Use the separate
# ignored billing-worker local file described by .dev.vars.billing.example.
