{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elysia-ecobotics-online.example/schemas/addon-manifest.schema.json",
  "title": "Elysia Add-on Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "publisher",
    "version",
    "category",
    "summary",
    "description",
    "trust_tier",
    "local_only",
    "network_access",
    "dependencies",
    "actions",
    "security",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "Files",
        "Research / Web",
        "Models",
        "Data / Science",
        "GIS",
        "Services",
        "Robotics / Field",
        "Developer Tools",
        "Security",
        "External Managers"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "trust_tier": {
      "enum": [
        "official",
        "reviewed",
        "community",
        "unreviewed",
        "deprecated",
        "blocked"
      ]
    },
    "status": {
      "enum": [
        "available",
        "saved",
        "pending_review",
        "approved",
        "rejected",
        "deprecated",
        "security_hold"
      ]
    },
    "local_only": {
      "type": "boolean"
    },
    "network_access": {
      "type": "boolean"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "package_name",
          "required"
        ],
        "properties": {
          "ecosystem": {
            "type": "string"
          },
          "package_name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "version_constraint": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_key",
          "action_label",
          "action_kind",
          "allowed",
          "risk_level",
          "requires_local_operator_password",
          "notes"
        ],
        "properties": {
          "action_key": {
            "type": "string"
          },
          "action_label": {
            "type": "string"
          },
          "action_kind": {
            "enum": [
              "python_package_install",
              "python_package_uninstall",
              "docker_compose_setup",
              "docker_compose_start",
              "docker_compose_stop",
              "docker_compose_restart",
              "config_toggle",
              "open_external_manager",
              "manual_instruction",
              "setup_script"
            ]
          },
          "allowed": {
            "type": "boolean"
          },
          "risk_level": {
            "enum": [
              "low",
              "moderate",
              "high",
              "critical",
              "unknown"
            ]
          },
          "requires_local_operator_password": {
            "type": "boolean"
          },
          "network_access": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_only",
        "model_accessible",
        "chat_accessible",
        "memory_promotion_allowed",
        "outward_sharing_allowed",
        "local_file_access"
      ],
      "properties": {
        "operator_only": {
          "type": "boolean"
        },
        "model_accessible": {
          "type": "boolean"
        },
        "chat_accessible": {
          "type": "boolean"
        },
        "memory_promotion_allowed": {
          "type": "boolean"
        },
        "outward_sharing_allowed": {
          "type": "boolean"
        },
        "local_file_access": {
          "enum": [
            "none",
            "selected_files_only",
            "project_scope",
            "broad"
          ]
        },
        "outward_sharing_risk": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "homepage_url": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "license": {
      "type": "string"
    }
  }
}
