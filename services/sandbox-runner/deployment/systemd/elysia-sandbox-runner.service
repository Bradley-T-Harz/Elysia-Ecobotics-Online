[Unit]
Description=Elysia governed sandbox runner
Documentation=file:///opt/elysia-sandbox-runner/current/services/sandbox-runner/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/elysia-sandbox-runner/current
EnvironmentFile=%h/.config/elysia-sandbox-runner/runner.env
ExecStart=/usr/bin/node services/sandbox-runner/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
LimitCORE=0
Delegate=yes
# Rootless Podman requires user and mount namespace setup. Outer-service
# namespace protections that block Podman are intentionally omitted; each
# execution container enforces the stronger per-job isolation boundary.
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true

[Install]
WantedBy=default.target
