[Unit]
Description=Remove expired Elysia sandbox raw job data and bounded audit logs

[Service]
Type=oneshot
WorkingDirectory=/opt/elysia-sandbox-runner/current
EnvironmentFile=%h/.config/elysia-sandbox-runner/runner.env
ExecStart=/usr/bin/node services/sandbox-runner/cleanup.mjs
UMask=0077
LimitCORE=0
Delegate=yes
# Rootless Podman cleanup requires user and mount namespace setup. Incompatible
# outer-service namespace protections are intentionally omitted.
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
