# Production values belong in a root-owned, mode-0640 file whose group is the
# dedicated elysia-sandbox account. The service account must not be able to edit it.
ELYSIA_SANDBOX_MODE=production
ELYSIA_SANDBOX_ENABLED=false
ELYSIA_SANDBOX_CONFIRM_SERVICE_EXECUTION=false
ELYSIA_SANDBOX_HOST=127.0.0.1
ELYSIA_SANDBOX_PORT=8788
ELYSIA_SANDBOX_ENGINE=podman
# Docker cold standby only: when deliberately selected after acceptance testing,
# define DOCKER_HOST=unix:///run/user/<ELYSIA_SANDBOX_UID>/docker.sock directly on the server.
ELYSIA_SANDBOX_RUNTIME_ROOT=/home/elysia-sandbox/.local/state/elysia-sandbox-runner
ELYSIA_SANDBOX_PYTHON_IMAGE=registry.example.invalid/elysia/sandbox-python@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
ELYSIA_SANDBOX_NODE_IMAGE=registry.example.invalid/elysia/sandbox-node@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
ELYSIA_SANDBOX_SERVICE_TOKEN=ENTER_DIRECTLY_ON_SERVER
# Non-secret Access application identity. The team domain must be the exact
# https://<team>.cloudflareaccess.com issuer and the audience must be the
# self-hosted sandbox application's AUD tag.
ELYSIA_SANDBOX_ACCESS_TEAM_DOMAIN=https://REPLACE_WITH_TEAM_NAME.cloudflareaccess.com
ELYSIA_SANDBOX_ACCESS_AUDIENCE=REPLACE_WITH_APPLICATION_AUDIENCE
ELYSIA_SANDBOX_JOB_RETENTION_SECONDS=3600
ELYSIA_SANDBOX_AUDIT_RETENTION_DAYS=14
