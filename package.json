{
  "name": "elysia-ecobotics-online",
  "private": true,
  "version": "0.1.0",
  "description": "Elysia Ecobotics Online: public website, marketplace, account hub, and commons ecosystem for Elysia.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test:routes": "node scripts/routeSmokeTest.mjs",
    "test:security": "node scripts/securitySmokeTest.mjs",
    "test:public-bundle-security": "node scripts/publicBundleSecurityAudit.mjs",
    "test:content": "node scripts/siteContentSmokeTest.mjs",
    "test:developer-forge-validator": "node scripts/generateDeveloperForgeManifestValidator.mjs --check",
    "test:developer-forge-browser:built": "node scripts/developerForgeBrowserSmokeTest.mjs",
    "test:developer-forge-browser": "npm run build && npm run test:developer-forge-browser:built",
    "test:public-commons-profile": "node scripts/publicCommonsProfileSmokeTest.mjs",
    "test:public-commons-profile-browser:built": "node scripts/publicCommonsProfileBrowserSmokeTest.mjs",
    "test:public-commons-profile-browser": "npm run build && npm run test:public-commons-profile-browser:built",
    "test:commons-profile-avatar-browser:built": "node scripts/commonsProfileAvatarBrowserSmokeTest.mjs",
    "test:commons-profile-avatar-browser": "npm run build && npm run test:commons-profile-avatar-browser:built",
    "test:commune-attribution-browser:built": "node scripts/communeAttributionBrowserSmokeTest.mjs",
    "test:commune-attribution-browser": "npm run build && npm run test:commune-attribution-browser:built",
    "test:artisan-portal": "node scripts/artisanPortalSmokeTest.mjs",
    "test:identity": "node scripts/identityWorkerSmokeTest.mjs",
    "test:identity-export-storage": "node scripts/identityExportStorageSmokeTest.mjs",
    "test:identity-auth-deletion": "node scripts/identityAuthDeletionSmokeTest.mjs",
    "test:identity-notification-delivery": "node scripts/identityNotificationDeliverySmokeTest.mjs",
    "test:online-identity": "node scripts/onlineIdentityUiSmokeTest.mjs",
    "test:auth-signup": "node scripts/authSignupSmokeTest.mjs",
    "test:auth-signup-browser:built": "node scripts/authSignupBrowserSmokeTest.mjs",
    "test:auth-signup-browser": "npm run build && npm run test:auth-signup-browser:built",
    "test:auth-turnstile:off": "VITE_AUTH_CAPTCHA_MODE=off npm run build && ELYSIA_AUTH_CAPTCHA_EXPECTED_MODE=off node scripts/authTurnstileBrowserSmokeTest.mjs",
    "test:auth-turnstile:preflight": "VITE_AUTH_CAPTCHA_MODE=preflight VITE_AUTH_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run build && ELYSIA_AUTH_CAPTCHA_EXPECTED_MODE=preflight node scripts/authTurnstileBrowserSmokeTest.mjs",
    "test:auth-turnstile:required": "VITE_AUTH_CAPTCHA_MODE=required VITE_AUTH_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run build && ELYSIA_AUTH_CAPTCHA_EXPECTED_MODE=required node scripts/authTurnstileBrowserSmokeTest.mjs",
    "test:auth-turnstile:contract": "node scripts/authTurnstileContractTest.mjs",
    "test:auth-turnstile": "npm run test:auth-turnstile:contract && npm run test:auth-signup && npm run test:auth-turnstile:off && npm run test:auth-turnstile:preflight && npm run test:auth-turnstile:required",
    "test:commune": "node scripts/communeSmokeTest.mjs",
    "test:sandbox-runner": "node scripts/sandboxRunnerSmokeTest.mjs",
    "test:sandbox-access": "node scripts/sandboxAccessSmokeTest.mjs",
    "test:sandbox-finalizer": "node scripts/sandboxFinalizerTokenSmokeTest.mjs",
    "test:sandbox-proxy": "node scripts/sandboxProxySmokeTest.mjs",
    "test:sandbox-deployment": "node scripts/sandboxDeploymentSmokeTest.mjs",
    "test:sandbox-integration": "node scripts/sandboxIntegrationSmokeTest.mjs",
    "test:sandbox-database": "node scripts/sandboxDatabaseMigrationTest.mjs",
    "test:sandbox-database:disposable": "ELYSIA_SANDBOX_DATABASE_INTEGRATION=1 node scripts/sandboxDatabaseMigrationTest.mjs",
    "test:supabase-readonly-inventory": "node scripts/supabaseReadOnlyInventorySmokeTest.mjs",
    "test:addons": "node scripts/addonSdkSmokeTest.mjs",
    "test:cli": "node scripts/addonSdkSmokeTest.mjs",
    "test:archive": "node scripts/addonSdkSmokeTest.mjs",
    "test:billing-proxy": "node scripts/billingProxySmokeTest.mjs",
    "test:billing-redirect": "node scripts/billingRedirectCompatibilitySmokeTest.mjs",
    "test:billing-stripe": "node scripts/billingStripeSmokeTest.mjs",
    "test:billing-catalog": "node scripts/billingStripeCatalogSmokeTest.mjs",
    "test:billing-fixed-catalog": "node scripts/billingStripeFixedPriceCatalogSmokeTest.mjs",
    "test:billing-sandbox-program": "node scripts/billingSandboxRecurringTestProgramSmokeTest.mjs",
    "test:billing-isolation": "node scripts/billingWorkerIsolationSmokeTest.mjs",
    "test:billing-operator": "node scripts/billingOperatorSmokeTest.mjs",
    "test:billing-job-post": "node scripts/billingJobPostSmokeTest.mjs",
    "test:billing-observability": "node scripts/billingObservabilitySmokeTest.mjs",
    "test:billing-sandbox": "node scripts/billingSandboxCommerceSmokeTest.mjs",
    "test:billing-marketplace": "node scripts/billingMarketplaceCommerceSmokeTest.mjs",
    "test:billing-organizations": "node scripts/billingOrganizationAssistanceSmokeTest.mjs",
    "test:billing-lifecycle": "node scripts/billingLifecycleSmokeTest.mjs",
    "test:billing-activation": "node scripts/economicTestActivationSmokeTest.mjs",
    "test:economic-frontend": "node scripts/economicFrontendSmokeTest.mjs",
    "test:economic-legal-integrity": "node scripts/economicLegalContentIntegritySmokeTest.mjs",
    "test:billing": "npm run test:billing-proxy && npm run test:billing-redirect && npm run test:billing-stripe && npm run test:billing-catalog && npm run test:billing-fixed-catalog && npm run test:billing-sandbox-program && npm run test:billing-isolation && npm run test:billing-operator && npm run test:billing-job-post && npm run test:billing-sandbox && npm run test:billing-marketplace && npm run test:billing-organizations && npm run test:billing-lifecycle && npm run test:billing-observability && npm run test:billing-activation && npm run test:economic-frontend && npm run test:economic-legal-integrity",
    "test:all": "npm run test:routes && npm run test:security && npm run test:content && npm run test:developer-forge-validator && npm run test:public-commons-profile && npm run test:artisan-portal && npm run test:identity && npm run test:identity-export-storage && npm run test:identity-auth-deletion && npm run test:identity-notification-delivery && npm run test:online-identity && npm run test:auth-signup && npm run test:commune && npm run test:addons && npm run test:billing && npm run test:sandbox-runner && npm run test:sandbox-access && npm run test:sandbox-finalizer && npm run test:sandbox-proxy && npm run test:sandbox-deployment && npm run test:sandbox-integration && npm run test:sandbox-database && npm run test:supabase-readonly-inventory && npm run typecheck && npm run typecheck:functions && npm run build && npm run test:developer-forge-browser:built && npm run test:public-commons-profile-browser:built && npm run test:commons-profile-avatar-browser:built && npm run test:auth-signup-browser:built && npm run test:commune-attribution-browser:built && npm run test:public-bundle-security",
    "test:release": "npm run test:all && npm run test:sandbox-database:disposable",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "types:identity": "wrangler types services/identity-worker/worker-configuration.d.ts --config wrangler.identity.example.jsonc --env-file .dev.vars.identity.example --include-runtime false --env-interface IdentityBindings",
    "billing:stripe:test-catalog": "node scripts/billingStripeTestCatalog.mjs",
    "billing:stripe:test-fixed-price": "node scripts/billingStripeFixedPriceTestCatalog.mjs",
    "billing:sandbox:test-recurring-program": "node scripts/billingSandboxRecurringTestProgram.mjs",
    "economic:test-activation": "node scripts/economicTestActivation.mjs",
    "sandbox:release": "node scripts/packageSandboxRelease.mjs",
    "sandbox:verify-release": "node scripts/verifySandboxRelease.mjs",
    "sandbox:finalizer:check": "node scripts/sandboxFinalizerTokenTool.mjs check",
    "sandbox:doctor": "node services/sandbox-runner/cli.mjs doctor",
    "sandbox:validate": "node services/sandbox-runner/cli.mjs validate",
    "sandbox:run": "node services/sandbox-runner/cli.mjs run",
    "sandbox:validate-snapshot": "node services/sandbox-runner/cli.mjs validate-snapshot",
    "sandbox:run-snapshot": "node services/sandbox-runner/cli.mjs run-snapshot",
    "generate:developer-forge-validator": "node scripts/generateDeveloperForgeManifestValidator.mjs",
    "sandbox:serve": "node services/sandbox-runner/server.mjs",
    "addon": "node scripts/elysiaAddonCli.mjs",
    "addon:init": "node scripts/elysiaAddonCli.mjs init",
    "addon:validate": "node scripts/elysiaAddonCli.mjs validate",
    "addon:scan": "node scripts/elysiaAddonCli.mjs scan",
    "addon:package": "node scripts/elysiaAddonCli.mjs package",
    "addon:inspect": "node scripts/elysiaAddonCli.mjs inspect",
    "addon:doctor": "node scripts/elysiaAddonCli.mjs doctor"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "2.106.2",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cmdk": "^1.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "1.17.0",
    "monaco-editor": "0.53.0",
    "nanoid": "^5.1.15",
    "prettier": "^3.9.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "yaml": "^2.9.0",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260623.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "playwright": "1.61.1",
    "wrangler": "4.104.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260623.1": true
  }
}
