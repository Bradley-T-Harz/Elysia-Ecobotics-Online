{
  "name": "elysia-ecobotics-online",
  "private": true,
  "version": "0.1.0",
  "description": "Elysia Ecobotics Online: public website, marketplace, account hub, and commons ecosystem for Elysia.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test:routes": "node scripts/routeSmokeTest.mjs",
    "test:security": "node scripts/securitySmokeTest.mjs",
    "test:content": "node scripts/siteContentSmokeTest.mjs",
    "test:commune": "node scripts/communeSmokeTest.mjs",
    "test:sandbox-runner": "node scripts/sandboxRunnerSmokeTest.mjs",
    "test:addons": "node scripts/addonSdkSmokeTest.mjs",
    "test:cli": "node scripts/addonSdkSmokeTest.mjs",
    "test:archive": "node scripts/addonSdkSmokeTest.mjs",
    "test:all": "npm run test:routes && npm run test:security && npm run test:content && npm run test:commune && npm run test:addons && npm run test:sandbox-runner && npm run typecheck && npm run build",
    "addon": "node scripts/elysiaAddonCli.mjs",
    "addon:init": "node scripts/elysiaAddonCli.mjs init",
    "addon:validate": "node scripts/elysiaAddonCli.mjs validate",
    "addon:scan": "node scripts/elysiaAddonCli.mjs scan",
    "addon:package": "node scripts/elysiaAddonCli.mjs package",
    "addon:inspect": "node scripts/elysiaAddonCli.mjs inspect",
    "addon:doctor": "node scripts/elysiaAddonCli.mjs doctor"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "ajv": "^8.20.0",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.16.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "wrangler": "^4.100.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260611.1": true
  }
}
