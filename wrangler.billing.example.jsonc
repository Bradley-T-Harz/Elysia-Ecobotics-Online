{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elysia-ecobotics-billing-test",
  "main": "services/billing-worker/worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Intentionally no `routes` or `triggers` entry. Add a protected non-live
  // route and private notification-retry cron only in a separately reviewed,
  // environment-specific deployment configuration.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // Keep the allowlisted structured billing events without automatically
      // retaining request URLs or query strings.
      "invocation_logs": false
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0
    }
  },
  "vars": {
    "BILLING_ENABLED": "false",
    "BILLING_SUPPORT_CHECKOUT_ENABLED": "false",
    "BILLING_RECURRING_ENABLED": "false",
    "BILLING_WEBHOOK_FULFILLMENT_ENABLED": "false",
    "BILLING_NOTIFICATION_RETRY_ENABLED": "false",
    "BILLING_PORTAL_ENABLED": "false",
    "BILLING_SELLER_ONBOARDING_ENABLED": "false",
    "BILLING_JOB_POST_FEES_ENABLED": "false",
    "BILLING_SANDBOX_PURCHASES_ENABLED": "false",
    "BILLING_MARKETPLACE_COMMERCE_ENABLED": "false",
    "BILLING_MARKETPLACE_PAYOUT_PREPARATION_ENABLED": "false",
    "BILLING_ORGANIZATION_SERVICES_ENABLED": "false",
    "BILLING_SPONSORSHIP_ADMIN_ENABLED": "false",
    "BILLING_SPONSORSHIP_CHECKOUT_ENABLED": "false",
    "BILLING_SPONSORSHIP_RECOGNITION_ENABLED": "false",
    "BILLING_ASSISTANCE_ADMIN_ENABLED": "false",
    "BILLING_SUPPORT_RECOGNITION_ENABLED": "false",
    "BILLING_ACCOUNT_LIFECYCLE_ENABLED": "false",
    "BILLING_ACCOUNTING_EXPORT_ENABLED": "false",
    "BILLING_TEST_REFUNDS_ENABLED": "false",
    "BILLING_STAGING_ACCESS_CONFIRMED": "false",
    "BILLING_EDGE_RATE_LIMIT_CONFIRMED": "false",
    "BILLING_MODE": "test",
    "BILLING_PUBLIC_ORIGIN": "https://billing-test.example.invalid",
    "STRIPE_CONNECT_ENABLED": "false",
    "STRIPE_LIVE_ENABLED": "false",
    "STRIPE_WEBHOOK_TOLERANCE_SECONDS": "300",
    "STRIPE_API_VERSION": "REPLACE_WITH_REVIEWED_TEST_API_VERSION",
    "STRIPE_WEBHOOK_API_VERSION": "REPLACE_WITH_REVIEWED_TEST_WEBHOOK_API_VERSION",
    "SUPABASE_URL": "REPLACE_IN_CLOUDFLARE_DASHBOARD",
    "SUPABASE_PUBLISHABLE_KEY": "REPLACE_IN_CLOUDFLARE_DASHBOARD"
  }
  // Configure STRIPE_SECRET_KEY_TEST, STRIPE_WEBHOOK_SECRET_TEST, and
  // SUPABASE_SERVICE_ROLE_KEY only as encrypted bindings on this billing
  // Worker. Never add sandbox runner, finalizer, Access, or user-code bindings.
}
