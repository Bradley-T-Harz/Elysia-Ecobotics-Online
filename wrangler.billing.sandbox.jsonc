    "BILLING_PORTAL_ENABLED": "false",
    "BILLING_SELLER_ONBOARDING_ENABLED": "false",
    "BILLING_JOB_POST_FEES_ENABLED": "false",
    "BILLING_SANDBOX_PURCHASES_ENABLED": "false",
    "BILLING_MARKETPLACE_COMMERCE_ENABLED": "false",
    "BILLING_MARKETPLACE_PAYOUT_PREPARATION_ENABLED": "false",
    "BILLING_ORGANIZATION_SERVICES_ENABLED": "false",
    "BILLING_SPONSORSHIP_ADMIN_ENABLED": "false",
    "BILLING_SPONSORSHIP_CHECKOUT_ENABLED": "false",
    "BILLING_SPONSORSHIP_RECOGNITION_ENABLED": "false",
    "BILLING_ASSISTANCE_ADMIN_ENABLED": "false",
    "BILLING_SUPPORT_RECOGNITION_ENABLED": "false",
    "BILLING_ACCOUNT_LIFECYCLE_ENABLED": "false",
    "BILLING_ACCOUNTING_EXPORT_ENABLED": "false",
    "BILLING_TEST_REFUNDS_ENABLED": "false",
    "BILLING_STAGING_ACCESS_CONFIRMED": "false",
    "BILLING_EDGE_RATE_LIMIT_CONFIRMED": "false",
    "BILLING_FIRST_PARTY_PREFLIGHT_CONFIRMED": "false",
    "STRIPE_CONNECT_ENABLED": "false",
    "STRIPE_LIVE_ENABLED": "false",
    "BILLING_MODE": "disabled",
    "BILLING_PUBLIC_ORIGIN": "https://sandbox-not-yet-configured.invalid",
    "STRIPE_API_VERSION": "2025-02-24.acacia",
    "STRIPE_WEBHOOK_API_VERSION": "2025-02-24.acacia",
